{
  "schemaVersion": 1,
  "id": "quietbluemapofflineplayermarkers",
  "version": "${version}",
  "name": "QuietBlueMapOfflinePlayerMarkers",
  "description": "Adds markers where players have logged off to BlueMap, without spamming the server console",
  "authors": [
    "TechnicJelle",
    "Mark-255",
    "Blue",
    "Seercat3160",
    "Syorito Hatsuki",
    "o800"
  ],
  "contact": {
    "homepage": "https://github.com/TechnicJelle/BlueMapOfflinePlayerMarkers"
  },
  "license": "MIT Licence",
  "environment": "server",
  "mixins": [
    "bluemapofflineplayermarkers.mixins.json"
  ],
  "entrypoints": {
    "server": [
      "com.technicjelle.bluemapofflineplayermarkers.impl.fabric.BluemapOfflinePlayerMarkers"
    ]
  },
  "custom": {
    "fstats": 43,
    "duckyupdater": {
      "modrinthId": "wScpBUKd"
    }
